@using DNSLab.Web.DTOs.Repositories.DDNS
@attribute [Route(AllRoutes.MikroTikSettings)]
@attribute [Authorize]
<SeoProvider Title="تنظیمات میکروتیک" />

<MudText Typo="Typo.h1" Align="Align.Center">تنظیمات MikroTik</MudText>
<MudText Class="mt-5" Align="Align.Center">
    با استفاده از MikroTik می‌توانید آدرس IP عمومی خود را به‌صورت خودکار در DNSLab به‌روزرسانی کنید.
</MudText>
<MudText Class="mb-10" Align="Align.Center">
    مناسب برای MikroTik RouterOS و شبکه‌هایی با IP عمومی متغیر
</MudText>

<MudPaper Class="mt-5 pa-10" Outlined>
    <MudText Typo="Typo.h4" Class="mb-4">۱. ساخت کلید دسترسی</MudText>
    <MudText Class="mb-4">
        برای اینکه MikroTik بتواند IP عمومی شما را در DNSLab به‌روزرسانی کند،
        ابتدا باید یک کلید دسترسی ایجاد و انتخاب نمایید.
    </MudText>

    <UpdateTokens IsSelectableList OnTokenSelect="SelectToken" />

    @if (_Token == null)
    {
        <MudAlert Dense Icon="@DNSLabIcons.Info" ContentAlignment="HorizontalAlignment.Start" Class="mt-4">
            برای ادامه مراحل، ابتدا یکی از کلیدهای دسترسی را انتخاب نمایید.
        </MudAlert>
    }
    else
    {
        <MudText Typo="Typo.h4" Class="my-6">۲. ساخت Script در MikroTik</MudText>
        <MudText Class="mb-4">
            وارد پنل MikroTik شوید و از مسیر
            <strong class="dnslab-ltr dnslab-nano">System &gt; Scripts</strong>
            وارد بخش Scripts شوید. سپس با انتخاب گزینه
            <strong class="dnslab-ltr dnslab-nano">Add New</strong>
            یک Script جدید ایجاد کنید.
        </MudText>

        <MudText Typo="Typo.h6" Class="my-3">تنظیمات Script</MudText>
        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Name</MudText>
                <MudText>یک نام دلخواه برای Script انتخاب کنید.</MudText>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Policy</MudText>
                <MudText>فقط دسترسی‌های <strong>Test</strong> و <strong>Read</strong> را فعال کنید.</MudText>
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.h6" Class="my-3">Source</MudText>
        <MudText Class="mb-2">
            دستور زیر را در قسمت Source قرار دهید:
        </MudText>
        <CodeSnippet Language="bash" Code="@($"/tool fetch url=\"https://api.dnslab.link/DDNS/U?k={_Token.Key}\"")" />

        <MudAlert Icon="@DNSLabIcons.Error"
                  Dense
                  ContentAlignment="HorizontalAlignment.Start"
                  Variant="Variant.Text"
                  Class="mt-3">
            در برخی نسخه‌ها یا تنظیمات MikroTik ممکن است استفاده از علامت
            <span class="dnslab-ltr dnslab-nano">?</span>
            در URL با مشکل مواجه شود. در این صورت از دستور زیر استفاده کنید:
        </MudAlert>

        <CodeSnippet Language="bash" Code="@($"/tool fetch url=\"https://api.dnslab.link/DDNS/U/{_Token.Key}\"")" />

        <MudText Typo="Typo.h4" Class="my-6">۳. ساخت Scheduler</MudText>
        <MudText Class="mb-4">
            برای اینکه Script به‌صورت خودکار اجرا شود، باید یک Scheduler ایجاد کنید.
            از مسیر
            <strong class="dnslab-ltr dnslab-nano">System &gt; Scheduler</strong>
            یک Scheduler جدید ایجاد نمایید.
        </MudText>

        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Interval</MudText>
                <MudText>
                    مقدار Interval را روی
                    <strong class="dnslab-ltr dnslab-nano">3m</strong>
                    قرار دهید.
                </MudText>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.body2" Color="Color.Secondary">On Event</MudText>
                <MudText>
                    نام Script ساخته‌شده در مرحله قبل را وارد کنید.
                </MudText>
            </MudItem>
        </MudGrid>

        <MudAlert Severity="Severity.Info"
                  Dense
                  ContentAlignment="HorizontalAlignment.Start"
                  Class="mt-4">
            با این تنظیمات، Script هر ۳ دقیقه یک‌بار اجرا می‌شود و IP عمومی MikroTik
            به DNSLab اعلام خواهد شد.
        </MudAlert>

        <MudText Typo="Typo.h4" Class="my-6">۴. پایان تنظیمات</MudText>
        <MudAlert Severity="Severity.Success" ContentAlignment="HorizontalAlignment.Start">
            پس از انجام مراحل بالا، MikroTik به‌صورت خودکار IP عمومی خود را به DNSLab
            اعلام می‌کند. از این پس می‌توانید از DNSهای انتخاب‌شده در این کلید برای
            دسترسی به شبکه خود استفاده کنید.
        </MudAlert>
    }
</MudPaper>